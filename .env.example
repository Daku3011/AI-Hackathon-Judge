# AI Hackathon Judge - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED
# ============================================================================

# Google Gemini API Key (required for AI analysis)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# OPTIONAL BUT RECOMMENDED
# ============================================================================

# GitHub Personal Access Token (improves rate limits for repo analysis)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# VIDEO ANALYSIS OPTIONS
# ============================================================================

# Directory for caching video transcripts (default: /tmp/transcript_cache)
# On Render.com or similar platforms, use /tmp for ephemeral storage
TRANSCRIPT_CACHE_DIR=/tmp/transcript_cache

# Cache expiry time in seconds (default: 86400 = 24 hours)
# Longer expiry reduces API calls but uses more disk space
TRANSCRIPT_CACHE_EXPIRY=86400

# YouTube proxy server (optional, only if needed to bypass restrictions)
# Example: http://proxy-server:8080
# YOUTUBE_PROXY=

# YouTube cookies file (optional, only if needed for authentication)
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# ============================================================================
# DEPLOYMENT OPTIONS
# ============================================================================

# Server port (default: 8000)
# On Render.com, this is automatically set by the platform
PORT=8000

# ============================================================================
# NOTES
# ============================================================================
# - Never commit .env file to git (it's in .gitignore)
# - For production deployments, use platform-specific secret management
# - Render.com: Add environment variables in the dashboard
# - Docker: Use docker-compose.yml or --env-file flag
